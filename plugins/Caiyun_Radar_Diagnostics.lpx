#!name=彩云降水接口诊断
#!desc=可选的只读诊断。打开彩云降水图后在Loon脚本日志查看响应结构，用于核对新版原生接口。只记录接口类别/状态码/字段类型，不记录Token、Cookie、查询参数或坐标；不修改会员或地图数据。
#!author=Nek0-hinata
#!homepage=https://github.com/Nek0-hinata/loon_plugin/blob/main/docs/RAIN_FORECAST.md
#!system=iOS,iPadOS,macOS
#!loon_version=3.5.0
#!tag=天气,诊断
#!date=2026-10-20

[Script]
http-response ^https:\/\/(?:api|wrapper)\.(?:cyapi\.cn|caiyunapp\.com)\/v\d+\/(?:radar|nafp|satellite)(?:[/?]|$) script-path=https://raw.githubusercontent.com/Nek0-hinata/loon_plugin/main/scripts/Rain_Forecast.js, requires-body=true, timeout=10, tag=彩云降水接口结构

[MitM]
hostname=api.cyapi.cn,wrapper.cyapi.cn,api.caiyunapp.com,wrapper.caiyunapp.com
