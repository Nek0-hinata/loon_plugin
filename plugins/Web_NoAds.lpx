#!name=网页去广告合集
#!desc=合并 4KHD、Jable、XVideos、Pornhub 与 PixiBB 的去广告、防强制跳转规则；各站规则独立匹配。
#!author=Codex
#!system=iOS,iPadOS,macOS
#!loon_version=3.2.1(730)
#!tag=去广告,网页净化,防跳转
#!date=2026-09-13

[Rule]
# 4KHD 广告基础设施
DOMAIN-SUFFIX,pemsrv.com,REJECT
DOMAIN-SUFFIX,magsrv.com,REJECT
DOMAIN,pfec.uuss.uk,REJECT
DOMAIN,online.ssuu.uk,REJECT

# PixiBB 强制跳转目标
DOMAIN-SUFFIX,happylength.com,REJECT

# Jable / XVideos / Pornhub 广告基础设施
DOMAIN-SUFFIX,trafficjunky.net,REJECT
DOMAIN-SUFFIX,adtng.com,REJECT
DOMAIN-SUFFIX,dzhjmp.com,REJECT
DOMAIN-SUFFIX,orbsrv.com,REJECT
DOMAIN-SUFFIX,ackcdn.net,REJECT
DOMAIN-SUFFIX,aucdn.net,REJECT
DOMAIN-SUFFIX,aacdn.net,REJECT
DOMAIN-SUFFIX,rtbix.com,REJECT
DOMAIN-SUFFIX,ad1n.net,REJECT
DOMAIN-SUFFIX,rtbsuperhub.com,REJECT
DOMAIN-SUFFIX,tjk-njk.com,REJECT
DOMAIN-SUFFIX,zline0.com,REJECT
DOMAIN-SUFFIX,dszkvm.com,REJECT
DOMAIN-SUFFIX,ktkjmp.com,REJECT

[Rewrite]
# 4KHD：放行 config.js；只清理 interstitial.js 广告 Worker，等待缓存清理后再刷新
# 注入仅匹配 HTML 文档开头，保留 head 属性；不改写外部 JS 中的 HTML 字符串
^https?:\/\/(?:www\.)?4khd\.com\/interstitial\.js(?:\?.*)?$ reject-200
^https?:\/\/(?:www\.)?4khd\.com\/js\/a1000d\.js(?:\?.*)?$ reject-200
^https?:\/\/(?:www\.)?4khd\.com\/.* response-body-replace-regex (?i)^((?:[\s\uFEFF]|<!--(?:[^-]|-(?!->))*-->|<!doctype(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>|<html(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>)*<head(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>) $1<script>((A,O)=>{const/**/isAdWorker=w=>{try{const/**/u=new/**/URL(w.scriptURL,location.href);return(u.origin===location.origin&&u.pathname==="/interstitial.js")}catch(e){return(false)}};(async()=>{let/**/reload=false;const/**/sw=navigator.serviceWorker;if(sw){const/**/rs=await/**/sw.getRegistrations().catch(()=>[]);await/**/Promise.all(rs.map(async(r)=>{const/**/workers=[r.active,r.waiting,r.installing].filter(isAdWorker);if(!workers.length)return;try{if(await/**/r.unregister())reload=reload||(isAdWorker(sw.controller)&&workers.some(w=>w.scriptURL===sw.controller.scriptURL))}catch(e){}}))}if(window.caches)await/**/caches.keys().then(ks=>Promise.all(ks.filter(k=>k==="my-cache"||k==="img-cache").map(k=>caches.delete(k).catch(()=>false)))).catch(()=>{});if(reload)location.reload()})().catch(()=>{});EventTarget.prototype.addEventListener=function(t,l,o){if(t==="click"&&typeof(l)==="function"&&/(?:popMagic|exoJsPop|pemsrv|magsrv)/.test(Function.prototype.toString.call(l)))return;return(A.apply(this,arguments))};window.open=function(u){try{const/**/h=new/**/URL(String(u),location.href);if(/(?:^|[.])(?:pemsrv|magsrv)[.]com$|^(?:pfec[.]uuss|online[.]ssuu)[.]uk$/i.test(h.hostname))return(null)}catch(e){}return(O.apply(this,arguments))};document.addEventListener("DOMContentLoaded",()=>document.querySelectorAll('ins[class^="eas"],ins[class^="adsby"],.centbtd,.ex-over-top,#popmagicldr').forEach(e=>e.remove()),{once:true})})(EventTarget.prototype.addEventListener,window.open);</script>

# PixiBB：仅关闭 hub/sexy 的全页点击推广弹窗及中转页，不改写视频 iframe、播放器脚本或媒体接口
^https?:\/\/(?:hub|sexy)\.pixibb\.com\/promotion\/(?:sexy-cosplay|sexy-girls)\/?(?:\?.*)?$ reject-200
^https?:\/\/(?:hub|sexy)\.pixibb\.com\/.* response-body-replace-regex window\.open\(targetUrl,\s*"_blank"\); void(0);

# Jable：CSS 持续隐藏广告；不再逐次扫描整页或删除含广告的整个 section
^https?:\/\/(?:www\.)?jable\.tv\/.* response-body-replace-regex (?i)^((?:[\s\uFEFF]|<!--(?:[^-]|-(?!->))*-->|<!doctype(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>|<html(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>)*<head(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>) $1<style>.plyr__ads,.asg-interstitial,[id^="asg-"],[id^="exo-native-widget-"],[id^="exoNativeWidget"],img[src*="tapioni.com/ab-banner.png"],section.video-info>div.text-center>ins,section.video-info>div.text-center>iframe,.right-sidebar>div.text-center>iframe{display:none!important}</style>

# XVideos：CSS 持续隐藏播放器广告、页头/页尾广告和 Exo 原生广告
^https?:\/\/(?:www\.)?xvideos\.com\/.* response-body-replace-regex (?i)^((?:[\s\uFEFF]|<!--(?:[^-]|-(?!->))*-->|<!doctype(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>|<html(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>)*<head(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>) $1<style>#hlsplayer>.videoad-base,#ad-header-mobile-contener,#ad-footer,.exo-ad-ins-div.exo-ad-playersiderectangle,.exo-ad-ins-container.ad-support-desktop,.thumb-ad.thumb-nat-ad.thumb-nat-exo-ad,a.ignore-popunder[href^="https://s."]{display:none!important}</style>

# Pornhub：阻止广告接口/投放脚本，CSS 隐藏广告；只替换 HTML class 中的 popunder 标记
^https?:\/\/(?:www\.)?pornhub\.com\/_xa\/ads(?:_batch)?(?:\?.*)?$ reject-200
^https?:\/\/static\.trafficjunky\.com\/invocation\/(?:embeddedads|popunder)\/.*$ reject-200
^https?:\/\/(?:www\.)?pornhub\.com\/.* response-body-replace-regex (<[a-zA-Z](?:[^<>"']|"[^"]*"|'[^']*')*?\s[cC][lL][aA][sS][sS]\s*=\s*["'][^"'<>]*?)(?<![^\s"'])js-popUnder(?=[\s"']) $1js-noPopUnder (?i)^((?:[\s\uFEFF]|<!--(?:[^-]|-(?!->))*-->|<!doctype(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>|<html(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>)*<head(?=[\s>])(?:[^<>"']|"[^"]*"|'[^']*')*>) $1<style>ins.adsbytrafficjunky,#popsByTrafficJunky,#pb_iframe,.sideAds,.home-ad-container,.browse-ad-container,.playlist-ad-container,.communityAds,.photo-ad-container,#advertisementBox,.ad_box,.js-nativeTjVideoGrid.js_promoItem{display:none!important}</style>

[Mitm]
hostname = 4khd.com,www.4khd.com,hub.pixibb.com,sexy.pixibb.com,jable.tv,www.jable.tv,xvideos.com,www.xvideos.com,pornhub.com,www.pornhub.com,static.trafficjunky.com
